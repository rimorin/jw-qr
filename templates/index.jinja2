{% extends "base.jinja2" %}

{#
  Macro: form_field
  Renders a labelled text input with consistent markup.
  Parameters:
    field_id  – the input's id/name attribute
    label     – visible label text
    required  – whether the field is required (default false)
    placeholder – placeholder text (default "")
#}
{% macro form_field(field_id, label, required=false, placeholder="", autocomplete="", inputmode="") %}
<div class="form-field">
  <label for="{{ field_id }}">{{ label }}</label>
  <input
    type="text"
    id="{{ field_id }}"
    name="{{ field_id }}"
    placeholder="{{ placeholder }}"
    {% if required %}required{% endif %}
    {% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
    {% if inputmode %}inputmode="{{ inputmode }}"{% endif %}
  >
</div>
{% endmacro %}

{% block content %}
<div id="loader" class="loader loader-default" data-text="Processing Request" data-blink
     role="status" aria-live="polite" aria-label="Processing request"></div>
<button id="infoBtn" class="icon-btn" aria-label="Help">
  <i class="fa fa-circle-info" aria-hidden="true"></i>
</button>
<main>
  <form action="{{ url_for('index') }}" method="post" aria-label="QR code generator">
    <div class="logo-container">
      <img height="100" width="100" src="{{ url_for('static', filename='jwqr.png') }}" alt="JWQR logo">
    </div>
    {{ form_field('article-link', 'Enter article link', required=true, placeholder='Paste Link Here', autocomplete='url', inputmode='url') }}
    {{ form_field('article-title', 'Enter title', placeholder='Optional', autocomplete='off') }}
    <div class="form-field">
      <label>Select Design</label>
      <div class="slider-wrapper">
        <button id="prevBtn" class="slide-btn" type="button" aria-label="Previous design">
          <i class="fa fa-circle-arrow-left" aria-hidden="true"></i>
        </button>
        <div class="slider">
          <div class="slide">
            <img alt="QR template 1" src="{{ url_for('static', filename='designs/design_1.jpg') }}"/>
          </div>
          <div class="slide">
            <img alt="QR template 2" src="{{ url_for('static', filename='designs/design_2.jpg') }}"/>
          </div>
        </div>
        <button id="nextBtn" class="slide-btn" type="button" aria-label="Next design">
          <i class="fa fa-circle-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="sample-letter">
      <label for="require-letter">Include sample letter?</label>
      <input type="checkbox" id="require-letter">
    </div>
    <div class="form-actions">
      <button class="btn" id="paste" type="button">
        <i class="fa fa-paste" aria-hidden="true"></i> Paste
      </button>
      <button class="btn" id="clear" type="button">
        <i class="fa fa-trash" aria-hidden="true"></i> Clear
      </button>
      <button id="submitBtn" type="button" class="btn">
        <i class="fa fa-qrcode" aria-hidden="true"></i> Generate
      </button>
    </div>
  </form>
</main>
{% include 'notes.jinja2' %}
{% include 'openai.jinja2' %}
{% endblock %}
